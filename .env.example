# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Email Delivery Configuration for Contact Form (/api/contact)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CONTACT_RECIPIENT_EMAIL="altajatwork@gmail.com"

# Private admin datastore.
# Local development uses .local/admin-data-store.json and does not require DATABASE_URL.
# Vercel/production uses Neon/Vercel Postgres and requires DATABASE_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.example/api/auth/google/callback"
# Register this exact local callback URL in the same Google OAuth client for the stdio MCP server.
MCP_GOOGLE_REDIRECT_URI="http://127.0.0.1:8787/mcp/oauth/callback"
ADMIN_GOOGLE_EMAILS="altajvirani786@gmail.com,altajatwork@gmail.com"
DATABASE_URL=""

