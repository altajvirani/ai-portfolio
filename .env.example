# GEMINI_API_KEY: Required for Gemini AI API calls for the AI Twin.
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Public chatbot abuse limits per client IP and global safety cap (to isolate and protect other projects).
CHAT_LIMIT_PER_MINUTE="15"
CHAT_LIMIT_PER_DAY="100"
CHAT_GLOBAL_DAILY_LIMIT="250"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Contact Recipient Email (inquiries are dispatched to this address from visitors' own email clients)
CONTACT_RECIPIENT_EMAIL="altajatwork@gmail.com"

# Private admin datastore.
# Local development uses .local/admin-data-store.json and does not require DATABASE_URL.
# Vercel/production uses Neon/Vercel Postgres and requires DATABASE_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.example/api/auth/google/callback"
# Register this exact local callback URL in the same Google OAuth client for the stdio MCP server.
MCP_GOOGLE_REDIRECT_URI="http://127.0.0.1:8787/mcp/oauth/callback"
ADMIN_GOOGLE_EMAILS="altajvirani786@gmail.com,altajatwork@gmail.com"
DATABASE_URL=""

